# Xcode / XcodeGen
build/
dist/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
XForge.xcodeproj/

# SwiftPM
.build/
.swiftpm/

# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json

# Embedded ish-arm64 engine
# (Vendor/ish-arm64 is a submodule/gitlink, so it is tracked; only its build
#  output below is ignored.)
# Static libraries produced by EmbeddedLinux/build-ish-core.sh.
Vendor/ish-arm64-build/

# Generated by XcodeGen from project.yml's `info.properties` — the spec is the
# single source of truth for the app's Info.plist.
Support/Info.plist

# Rootfs variants other than the release-pinned asset stay local. The pinned
# gzip archive is deliberately tracked so a clean checkout and CI-produced IPA
# contain the complete embedded Linux environment without a pre-build download.
Support/Resources/*.tar.xz
Support/Resources/*.tar.gz
!Support/Resources/alpine-minirootfs-3.24.2-aarch64.tar.gz
