XForge.xcodeproj/

# SwiftPM
.build/
.swiftpm/
# Where build-ipa.yml clones package checkouts (`clonedSourcePackagesDirPath`).
.spm/

# The native toolchain bundle. Installing it (`make toolchain-release`) unpacks
# hundreds of megabytes of LLVM/Swift archives into the checkout; they are
# reproducible from the release the manifest names, and committing them is never
# what anyone means to do. The directory and the gcc-style placeholder stay, so a
# clone has somewhere to install into.
Vendor/NativeToolchain/*
!Vendor/NativeToolchain/.gitkeep

# Where build-ipa.yml unpacks a fetched toolchain bundle.
.toolchain-artifact/

# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json


# Generated by XcodeGen from project.yml's `info.properties` — the spec is the
# single source of truth for the app's Info.plist.
Support/Info.plist

