# Xcode / XcodeGen
build/
dist/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
XForge.xcodeproj/

# SwiftPM
.build/
.swiftpm/

# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json

# Embedded ish-arm64 engine
# (Vendor/ish-arm64 is a submodule/gitlink, so it is tracked; only its build
#  output below is ignored.)
# Static libraries produced by EmbeddedLinux/build-ish-core.sh.
Vendor/ish-arm64-build/

# Generated by XcodeGen from project.yml's `info.properties` — the spec is the
# single source of truth for the app's Info.plist.
Support/Info.plist

# The bundled rootfs is a build product, not a source file: CI downloads it from
# the pinned `rootfs-v1` release and `make rootfs` builds it locally, so a clean
# checkout compiles and bundles one either way. Nothing here is tracked — an
# earlier revision committed a 4 MB tarball, and it stayed in the bundle long
# after the app stopped reading it (the IPA shipped both roots).
Support/Resources/*
!Support/Resources/.gitkeep
